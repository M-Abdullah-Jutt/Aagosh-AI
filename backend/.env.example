# Server Configuration
PROJECT_NAME="Aaghosh API"
API_V1_STR="/api/v1"
DEBUG=True

# CORS Configuration (JSON formatted array of origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Microsoft SQL Server Database Configuration
DB_SERVER=localhost\SQLEXPRESS
DB_PORT=1433
DB_NAME=AaghoshDB
DB_USER=sa
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=True

# SQLAlchemy Configuration
DB_ECHO=False

# JWT Authentication Configuration
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration
# Supported providers: gemini, openai, mock
LLM_PROVIDER=gemini
LLM_API_KEY=YOUR_GEMINI_OR_OPENAI_API_KEY_HERE
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000
MAX_CONVERSATION_MESSAGES=10

# Vector Store Configuration
# Options: 'chroma' (recommended, requires chromadb package) or 'file' (legacy JSON fallback)
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=data/chroma_store

# Cartesia Sonic TTS (human-like voice for Dr. Sophia human-like mode)
CARTESIA_API_KEY=sk_car_YOUR_CARTESIA_KEY_HERE
CARTESIA_VOICE_ID=79a125e8-cd45-4c13-8a67-188112f4dd22

# Simli AI Avatar (photorealistic video avatar for human-like coaching mode)
SIMLI_API_KEY=YOUR_SIMLI_API_KEY_HERE
SIMLI_FACE_ID=f0ba4efe-7946-45de-9955-c04a04c367b9


# LiveKit Cloud (WebRTC transport layer for real-time audio/video)
LIVEKIT_URL=wss://YOUR_LIVEKIT_SUBDOMAIN.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
